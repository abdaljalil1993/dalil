  "title": "شقة 3 غرف مفروشة",
  "description": "...",
  "price": 1500000,
  "pricePeriod": "monthly",
  "cityId": 6,
  "district": "الزراعة",
  "attributes": {
    "propertyType": "apartment",
    "rooms": 3,
    "bathrooms": 2,
    "area": 140,
    "floor": 2,
    "furnished": true,
    "ownership": "green_deed",
    "hasSolar": true
  },
  "contactPhone": "0944...",
  "businessId": null
}

### Update my listing
PUT {{base}}/listings/{{id}}
Authorization: Bearer {{token}}

### Close (sold/rented/filled) or re-open
PATCH {{base}}/listings/{{id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "closed"
}

### Delete my listing
DELETE {{base}}/listings/{{id}}
Authorization: Bearer {{token}}

### Upload images (field "images", max 15 total)
POST {{base}}/listings/{{id}}/images
Authorization: Bearer {{token}}

### Remove image by index
DELETE {{base}}/listings/{{id}}/images/{{index}}
Authorization: Bearer {{token}}

### Approve / reject / feature
PATCH {{base}}/listings/{{id}}/moderate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "active",
  "adminNote": "",
  "isFeatured": false
}

### Apply to a job (JSON or multipart with "image" = CV image)
POST {{base}}/listings/{{id}}/apply
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "أرغب بالتقدم...",
  "phone": "0944...",
  "cvUrl": null
}

### Applicants of my job post
GET {{base}}/listings/{{id}}/applications
Authorization: Bearer {{token}}

### Request a service — matching businesses are notified (multipart "images" optional)
POST {{base}}/service-requests
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": 9,
  "subCategoryId": 46,
  "cityId": 6,
  "district": "الزراعة",
  "title": "تركيب منظومة طاقة شمسية",
  "description": "منزل 3 غرف، بدي ألواح وبطارية ليثيوم...",
  "budget": 15000000,
  "preferredDate": "2026-11-10",
  "sharePhone": true
}

### My requests
GET {{base}}/service-requests/my
Authorization: Bearer {{token}}

### Open requests matching my businesses
GET {{base}}/service-requests/inbox
Authorization: Bearer {{token}}

### All requests
GET {{base}}/service-requests/admin/all
Authorization: Bearer {{token}}

### Request details + quotes
GET {{base}}/service-requests/{{id}}
Authorization: Bearer {{token}}

### Close / cancel / re-open my request
PATCH {{base}}/service-requests/{{id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "closed"
}

### Send / update a quote from my business
POST {{base}}/service-requests/{{id}}/quotes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "businessId": "uuid",
  "price": 14000000,
  "message": "نركّب خلال يومين مع ضمان سنة",
  "etaDays": 2
}

### Accept / reject a quote (request owner)
PATCH {{base}}/service-requests/quotes/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "accepted"
}

### Withdraw my quote
DELETE {{base}}/service-requests/quotes/{{id}}
Authorization: Bearer {{token}}

### My bookings (upcoming; all=true for history)
GET {{base}}/appointments/my
Authorization: Bearer {{token}}

### Bookings of my businesses
GET {{base}}/appointments/owner
Authorization: Bearer {{token}}

### Owner: confirm/reject/complete/no_show · Customer: cancel
PATCH {{base}}/appointments/{{id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "confirmed",
  "ownerNote": ""
}

### Send a 6-digit code by SMS (dev: returned as devCode)
POST {{base}}/auth/otp/request
Content-Type: application/json

{
  "phone": "0944123456"
}

### Verify code → tokens (creates account if new: firstName/lastName required)
POST {{base}}/auth/otp/verify
Content-Type: application/json

{
  "phone": "0944123456",
  "code": "123456",
  "firstName": "فادي",
  "lastName": "علي",
  "cityId": 6
}

### Signed-in user verifies/changes phone
POST {{base}}/auth/otp/verify-phone
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "0944123456",
  "code": "123456"
}

### Register FCM token for push notifications
POST {{base}}/devices
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "token": "fcm-token",
  "platform": "android",
  "locale": "ar"
}

### Unregister FCM token (on logout)
DELETE {{base}}/devices/{{token}}
Authorization: Bearer {{token}}

### Which services are ON for a governorate (hide the rest in the apps)
GET {{base}}/features

### Full switch configuration
GET {{base}}/features/admin
Authorization: Bearer {{token}}

### Turn services on/off — all governorates (cityIds: []) or only selected ones
PUT {{base}}/features/admin
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "features": {
    "jobs": {
      "enabled": true,
      "cityIds": [
        6
      ]
    },
    "realEstate": {
      "enabled": false
    }
  }
}

### What can be imported from OpenStreetMap (restaurants, hotels, pharmacies...)
GET {{base}}/admin/osm/presets
Authorization: Bearer {{token}}

### Start an import job (background). dryRun=true only counts. Never duplicates (osmId + same name within 150 m)
POST {{base}}/admin/osm/import
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "presets": [
    "restaurants",
    "hotels",
    "pharmacies"
  ],
  "scope": "governorate",
  "cityId": 6,
  "radiusKm": 10,
  "dryRun": true,
  "updateExisting": false
}

### Recent import jobs
GET {{base}}/admin/osm/jobs
Authorization: Bearer {{token}}

### Import job progress / result
GET {{base}}/admin/osm/jobs/{{id}}
Authorization: Bearer {{token}}

### Undo: delete unclaimed imported places with no reviews in a city / governorate
POST {{base}}/admin/osm/remove
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cityId": 6,
  "scope": "governorate",
  "dryRun": true
}

