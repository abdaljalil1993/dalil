Authorization: Bearer {{token}}

### Public settings (billingEnabled, support contacts, payment instructions)
GET {{base}}/billing/settings/public

### All platform settings
GET {{base}}/billing/settings
Authorization: Bearer {{token}}

### Update settings — billingEnabled=true starts enforcing plan limits
PUT {{base}}/billing/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "billingEnabled": false,
  "paymentInstructions": "...",
  "listingsRequireApproval": true,
  "listingDurationDays": 60
}

### Plans (all=true for admin to include inactive)
GET {{base}}/billing/plans
Authorization: Bearer {{token}}

### Create plan
POST {{base}}/billing/plans
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "gold",
  "name": "الذهبية",
  "priceMonthly": 100000,
  "priceYearly": 1000000,
  "features": {
    "maxImages": 30,
    "maxItems": -1,
    "maxActiveOffers": 10,
    "maxActiveListings": 20,
    "bookings": true,
    "quotes": true,
    "advancedStats": true,
    "verifiedBadge": true,
    "priorityBoost": 20,
    "featuredDaysPerMonth": 7,
    "socialLinks": true,
    "whatsappButton": true
  }
}

### Update plan
PUT {{base}}/billing/plans/{{id}}
Authorization: Bearer {{token}}

### Delete plan (only if unused)
DELETE {{base}}/billing/plans/{{id}}
Authorization: Bearer {{token}}

### My subscription requests & history
GET {{base}}/billing/subscriptions/my
Authorization: Bearer {{token}}

### Owner requests a plan (pending until payment confirmed)
