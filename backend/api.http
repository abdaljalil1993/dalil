# Dalilak API - REST Client file (VS Code "REST Client" extension)
@base = http://localhost:5003/api/v1
@token = paste_access_token_here

### Create account (role = user)
POST {{base}}/auth/register
Content-Type: application/json

{
  "firstName": "Fadi",
  "lastName": "Ali",
  "email": "fadi@example.com",
  "password": "Secret123",
  "phone": "+963991234567",
  "cityId": 1
}

### Sign in - returns accessToken, refreshToken, user
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "fadi@example.com",
  "password": "Secret123"
}

### Rotate tokens (old refresh token is revoked)
POST {{base}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "..."
}

### Revoke a refresh token
POST {{base}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "..."
}

### Revoke all sessions of the current user
POST {{base}}/auth/logout-all
Authorization: Bearer {{token}}

### Change password (revokes other sessions)
POST {{base}}/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "Secret123",
  "newPassword": "NewSecret456"
}

### Send reset link by email
POST {{base}}/auth/forgot-password
Content-Type: application/json

{
  "email": "fadi@example.com"
}

### Set a new password using the emailed token
POST {{base}}/auth/reset-password
Content-Type: application/json

{
  "token": "...",
  "newPassword": "NewSecret456"
}

### Current user
GET {{base}}/auth/me
Authorization: Bearer {{token}}

### My profile + counters
GET {{base}}/users/me
Authorization: Bearer {{token}}

### Update my profile
PUT {{base}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Fadi",
  "lastName": "Ali",
  "phone": "+963...",
  "bio": "...",
  "cityId": 1
}

### Upload avatar
POST {{base}}/users/me/avatar
Authorization: Bearer {{token}}

### List users
GET {{base}}/users
Authorization: Bearer {{token}}

### User details
GET {{base}}/users/{{id}}
Authorization: Bearer {{token}}

### Activate / suspend user
PATCH {{base}}/users/{{id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "suspended"
}

### Change user role
PATCH {{base}}/users/{{id}}/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "business_owner"
}

### Browse approved businesses (filters, no text search)
GET {{base}}/businesses
Authorization: Bearer {{token}}

### Search (text + filters + geo) - logs the query
GET {{base}}/businesses/search
Authorization: Bearer {{token}}

### Autocomplete (businesses, categories, sub-categories)
GET {{base}}/businesses/suggest
Authorization: Bearer {{token}}

### My businesses (all statuses)
GET {{base}}/businesses/my
Authorization: Bearer {{token}}

### All businesses for moderation
GET {{base}}/businesses/admin/all
Authorization: Bearer {{token}}

### Full business record for editing (owner/admin)
GET {{base}}/businesses/manage/{{id}}
Authorization: Bearer {{token}}

### Business details by slug or id (+ ratingBreakdown, viewer.isFavorite, viewer.myReview)
GET {{base}}/businesses/{{slug}}
Authorization: Bearer {{token}}

### Similar businesses
GET {{base}}/businesses/{{slug}}/related

### Track contact click (phone/whatsapp/directions/website)
POST {{base}}/businesses/{{id}}/track
Content-Type: application/json

{
  "type": "phone"
}

### Submit a business (pending review). Admin → published directly. isOwner=false → suggestion
POST {{base}}/businesses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "عيادة د. أحمد للعيون",
  "nameEn": "Dr. Ahmad Eye Clinic",
  "categoryId": 1,
  "subCategoryId": 3,
  "cityId": 1,
  "shortDescription": "استشاري طب وجراحة العيون",
  "description": "...",
  "address": "شارع بغداد، بناء 12",
  "district": "الزراعة",
  "latitude": 35.5317,
  "longitude": 35.7915,
  "phone": "041 123 456",
  "whatsapp": "+963991234567",
  "website": "https://example.com",
  "socialLinks": {
    "facebook": "https://facebook.com/..."
  },
  "priceRange": 2,
  "attributes": {
    "specialty": "جراحة الشبكية",
    "experienceYears": 15
  },
  "amenities": [
    "parking",
    "card_payment"
  ],
  "tags": [
    "عيون",
    "ليزر"
  ],
  "isOwner": true,
  "workingHours": [
    {
      "dayOfWeek": 0,
      "openTime": "09:00",
      "closeTime": "17:00"
    },
    {
      "dayOfWeek": 5,
      "isClosed": true
    }
  ]
}

