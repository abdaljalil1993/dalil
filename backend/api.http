### Delete business (owner/admin)
DELETE {{base}}/businesses/{{id}}
Authorization: Bearer {{token}}

### Business analytics (views, clicks, ratings)
GET {{base}}/businesses/{{id}}/stats
Authorization: Bearer {{token}}

### Approve / reject / suspend
PATCH {{base}}/businesses/{{id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "approved",
  "adminNote": "optional reason"
}

### Alias of /status (backward compatible)
PATCH {{base}}/businesses/{{id}}/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "approved"
}

### Set verified / active / owner
PATCH {{base}}/businesses/{{id}}/flags
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isVerified": true,
  "isActive": true,
  "ownerId": "uuid"
}

### Upload gallery images
POST {{base}}/businesses/{{id}}/images
Authorization: Bearer {{token}}

### Delete gallery image
DELETE {{base}}/businesses/{{id}}/images/{{imageId}}
Authorization: Bearer {{token}}

### Set primary image
PATCH {{base}}/businesses/{{id}}/images/{{imageId}}/primary
Authorization: Bearer {{token}}

### Upload cover image
POST {{base}}/businesses/{{id}}/cover
Authorization: Bearer {{token}}

### Upload logo
POST {{base}}/businesses/{{id}}/logo
Authorization: Bearer {{token}}

### Replace working hours (dayOfWeek 0=Sunday)
PUT {{base}}/businesses/{{id}}/hours
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hours": [
    {
      "dayOfWeek": 0,
      "openTime": "09:00",
      "closeTime": "17:00"
    },
    {
      "dayOfWeek": 5,
      "isClosed": true
    }
  ]
}

### Alias of PUT /hours
POST {{base}}/businesses/{{id}}/hours
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hours": [
    {
      "dayOfWeek": 0,
      "openTime": "09:00",
      "closeTime": "17:00"
    },
    {
      "dayOfWeek": 5,
      "isClosed": true
    }
  ]
}

### Business reviews
GET {{base}}/businesses/{{businessId}}/reviews
Authorization: Bearer {{token}}

### Rate & review (one per user, edit via PUT /reviews/:id)
POST {{base}}/businesses/{{businessId}}/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 5,
  "content": "خدمة ممتازة"
}

### Report wrong info / spam / fake review
POST {{base}}/businesses/{{businessId}}/reports
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "wrong_info",
  "description": "رقم الهاتف خاطئ",
  "reviewId": null
}

### Claim ownership of a listing added by admin
POST {{base}}/businesses/{{businessId}}/claim
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "أنا صاحب العيادة",
  "phone": "+963...",
  "proofUrl": null
}

### Home feed: categories, cities, ads, featured, top rated, newest, stats
GET {{base}}/home

### All categories with sub-categories and business counts
GET {{base}}/categories
Authorization: Bearer {{token}}

### Category by slug or id
GET {{base}}/categories/{{slug}}

### Create category
POST {{base}}/categories
Authorization: Bearer {{token}}
