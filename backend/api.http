  "businessId": "uuid",
  "planId": 2,
  "period": "monthly",
  "method": "sham_cash",
  "reference": "TX123",
  "note": ""
}

### All subscriptions
GET {{base}}/billing/subscriptions
Authorization: Bearer {{token}}

### Grant a subscription directly
POST {{base}}/billing/subscriptions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "businessId": "uuid",
  "planId": 2,
  "period": "monthly",
  "amount": 50000,
  "method": "cash"
}

### Update subscription (status / endDate / plan)
PATCH {{base}}/billing/subscriptions/{{id}}
Authorization: Bearer {{token}}

### Payments ledger
