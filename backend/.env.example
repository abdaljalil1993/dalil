# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5003
APP_NAME=Dalilak
# Public base URL of this API (used for local upload URLs & Swagger)
PUBLIC_URL=http://localhost:5003
# Web app URL (used in password-reset emails)
FRONTEND_URL=http://localhost:4173
APP_TIMEZONE=Asia/Damascus

# ─── Database (MySQL 8 / MariaDB 10.6+) ────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=dalilak
DB_LOGGING=false
# No migrations. Create/update tables with `npm run db:sync` (after every pull that changes entities)
# or import database/schema.sql. Keep false: auto-sync on start can wipe JSON columns on MariaDB.
DB_SYNCHRONIZE=false

# ─── Seed admin (npm run seed) ─────────────────────────
ADMIN_EMAIL=admin@dalilak.app
ADMIN_PASSWORD=Admin@12345

# ─── JWT (use long random strings in production) ───────
JWT_ACCESS_SECRET=change_this_to_a_strong_random_secret_access
JWT_REFRESH_SECRET=change_this_to_a_strong_random_secret_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Redis cache (optional) ────────────────────────────
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=600

# ─── Cloudinary (optional - without it images are stored in ./uploads) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP for password reset (optional - without it the link is logged) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Dalilak <no-reply@dalilak.app>

# ─── CORS (comma separated, or *) ──────────────────────
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173

# ─── Rate limits (requests / 15 min / IP) ──────────────
RATE_LIMIT_GLOBAL=1500
RATE_LIMIT_AUTH=20

LOG_LEVEL=info

# OpenStreetMap import (admin → Import from OpenStreetMap). Comma-separated Overpass mirrors.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
